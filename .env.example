# ─────────────────────────────────────────────────────────────
#  Flor de Seda / Aura Rosa — Variáveis de Ambiente Oficiais
#  Copie este arquivo para .env.local (desenvolvimento) ou .env (produção)
# ─────────────────────────────────────────────────────────────

# ── Ambiente & Servidor ──────────────────────────────────────
NODE_ENV=production
STORE_PORT=3000
ADMIN_PORT=3100
HOST=0.0.0.0

# ── URLs Públicas & Domínio ──────────────────────────────────
# Na Vercel ou Railway, configure a URL completa do seu domínio HTTPS
PUBLIC_URL=https://fashionstylogirlsbr.vercel.app
ADMIN_PUBLIC_URL=https://fashionstylogirlsbr.vercel.app

# ── Acesso & Segurança do Painel Administrativo ─────────────
# Caminho secreto do painel (ex: sualoja.com.br/janaadmin1978/)
ADMIN_PATH=janaadmin1978

# Credenciais de acesso do administrador
ADMIN_USER=JanaLopez
ADMIN_PASSWORD=1978JanaLopez

# Políticas de sessão e bloqueio de força bruta
ADMIN_SESSION_HOURS=8
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
CUSTOMER_SESSION_DAYS=30

# ── Gateway de Pagamento SyncPay (PIX & Cartão) ─────────────
# Credenciais oficiais da sua conta SyncPay
SYNCPAY_CLIENT_ID=2dffd631-f327-4fd8-aa6c-cf0bbe28a97e
SYNCPAY_CLIENT_SECRET=cde163b7-0107-45b8-8721-68f817c2ceba
SYNCPAY_BASE_URL=https://api.syncpayments.com.br/api/partner/v1

# ── Notificações via Bot do Telegram ─────────────────────────
# 1. Obtenha o token criando um bot com o @BotFather no Telegram
# 2. Obtenha seu Chat ID falando com @userinfobot ou enviando /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_POLLING=true
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Regras Comerciais & Frete ────────────────────────────────
FREE_SHIPPING_THRESHOLD=299
SHIPPING_PAC=19.90
SHIPPING_SEDEX=34.90
LOW_STOCK_THRESHOLD=3
CART_ABANDON_MINUTES=30

# ── Criptografia & Armazenamento (Opcional) ──────────────────
# Chaves mestras geradas automaticamente em server/data/keys.json
# Caso queira fixar via variável de ambiente:
# MASTER_KEY=
# ADMIN_PATH_SECRET=
# DATA_DIR=server/data
